# Clave de Google Gemini para la auditoría orientativa con IA (opcional).
# Sin clave, la plataforma funciona igual y el botón de auditoría muestra que no está disponible.
GEMINI_API_KEY=""

# Modelo de Gemini (opcional). Por defecto: gemini-2.5-flash
GEMINI_MODEL=""

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000
